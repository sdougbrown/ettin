{
  "name": "ettin-web",
  "version": "0.1.0",
  "private": true,
  "description": "Ettin — a two-headed room for persistent coding agents, over pi-durable.",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt --write src ui scripts",
    "fmt:check": "oxfmt --check src ui scripts"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.0.4",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-durable": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
